# Live Trading Guard
# ===================
# IMPORTANT: Do NOT set this to "true" until a real backtest engine replaces the
# random-number simulator. While this is unset or "false", all broker order placement
# (POST /api/ibkr/order and POST /api/kraken/order) returns HTTP 403 and no order
# is sent to any exchange. The check is enforced at both the route layer and the
# service layer (ibkr.placeOrder / kraken.placeOrder).
LIVE_TRADING_ENABLED=false

# LEAN Backtest Engine
# ====================
# Keep LEAN_ENABLED=false (or unset) in Replit. Set to "true" ONLY on the local
# machine where Docker and the lean CLI are installed and a workspace is initialized.
# When false/unset, backtests use the simulator (dataSource="simulated") and LEAN
# is never spawned. See LEAN_SETUP.md for the full local setup steps.
LEAN_ENABLED=false
# Path to the lean CLI binary (or "docker" if using Docker).
LEAN_COMMAND=lean
# Directory where LEAN workspace and project folders live.
LEAN_WORKSPACE_DIR=./lean-workspace
# Maximum milliseconds to wait for a single backtest run before killing it.
LEAN_BACKTEST_TIMEOUT_MS=600000

# IBKR Credentials (required for IBKR connector)
IBKR_ACCESS_TOKEN=
IBKR_ACCOUNT_ID=
IBKR_BASE_URL=

# Kraken Credentials (required for private Kraken endpoints)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# OpenAI (required for AI strategy agent)
OPENAI_API_KEY=

# LLM Resilience
# ==============
# Per-attempt timeout in milliseconds before the request is aborted and retried.
# Default: 60000 (60 seconds)
LLM_TIMEOUT_MS=60000
# Maximum number of retry attempts for transient failures (429/5xx/timeout/network).
# Non-retryable errors (401/400) are never retried regardless of this value.
# Default: 3
LLM_MAX_RETRIES=3

# Database
DATABASE_URL=
