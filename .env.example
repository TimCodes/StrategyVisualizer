# Live Trading Guard
# ===================
# IMPORTANT: Do NOT set this to "true" until a real backtest engine replaces the
# random-number simulator. While this is unset or "false", all broker order placement
# (POST /api/ibkr/order and POST /api/kraken/order) returns HTTP 403 and no order
# is sent to any exchange. The check is enforced at both the route layer and the
# service layer (ibkr.placeOrder / kraken.placeOrder).
LIVE_TRADING_ENABLED=false

# LEAN Backtest Engine
# ====================
# Keep LEAN_ENABLED=false (or unset) in Replit. Set to "true" ONLY on the local
# machine where Docker and the lean CLI are installed and a workspace is initialized.
# When false/unset, backtests use the simulator (dataSource="simulated") and LEAN
# is never spawned. See LEAN_SETUP.md for the full local setup steps.
LEAN_ENABLED=false
# Command the server spawns as `<LEAN_COMMAND> backtest <project>`. Either the
# locally installed lean CLI binary ("lean"), or — recommended — the Dockerized
# wrapper from packages/lean-engine (no local pip install needed):
#   Windows:     absolute path to packages\lean-engine\bin\lean-docker.exe
#                (compile once with `npm run build:shim` in that package;
#                .cmd/.ps1 won't work here — Node spawns this with shell:false)
#   Linux/macOS: absolute path to packages/lean-engine/bin/lean-docker.sh
# See packages/lean-engine/README.md.
LEAN_COMMAND=lean
# Directory where LEAN workspace and project folders live.
LEAN_WORKSPACE_DIR=./lean-workspace
# Maximum milliseconds to wait for a single backtest run before killing it.
LEAN_BACKTEST_TIMEOUT_MS=600000

# IBKR Credentials (required for IBKR connector)
IBKR_ACCESS_TOKEN=
IBKR_ACCOUNT_ID=
IBKR_BASE_URL=

# Kraken Credentials (required for private Kraken endpoints)
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# OpenAI (required for AI strategy agent)
OPENAI_API_KEY=

# LLM Resilience
# ==============
# Per-attempt timeout in milliseconds before the request is aborted and retried.
# Default: 60000 (60 seconds)
LLM_TIMEOUT_MS=60000
# Maximum number of retry attempts for transient failures (429/5xx/timeout/network).
# Non-retryable errors (401/400) are never retried regardless of this value.
# Default: 3
LLM_MAX_RETRIES=3

# Database
DATABASE_URL=

# Local Postgres (Docker): docker run -d --name praxis-postgres \
#   -e POSTGRES_USER=praxis -e POSTGRES_PASSWORD=praxis_local_dev -e POSTGRES_DB=praxis \
#   -p 5434:5432 -v praxis_pgdata:/var/lib/postgresql/data postgres:16
# Then: npm run db:push   (creates all tables)
# Example: DATABASE_URL=postgresql://praxis:praxis_local_dev@localhost:5434/praxis
# Neon URLs (containing neon.tech) use the serverless driver automatically.
# The dev script loads .env automatically (tsx --env-file-if-exists, Node 22.9+).

# Authentication (Phase 8) — single-user session auth.
# Unset/false = open mode (local dev). "true" = every /api route requires a
# session (except /api/auth/* and GET /api/system/status). Going live REQUIRES
# auth: the strategy state machine blocks the -> live transition while auth is
# disabled. Fail-closed: if enabled but PASSWORD/SECRET are missing, the API
# refuses requests rather than running open.
AUTH_ENABLED=false
AUTH_PASSWORD=
SESSION_SECRET=

# Incubation automation (Phase 12)
# ================================
# Optional in-process scheduler for nightly ghost runs (re-run incubating
# strategies' locked code on current data, auto-log paper observations).
# Cron expression; unset = no in-process scheduling (drive via
# POST /api/incubation/ghost-run from an external scheduler instead).
# Example: 0 2 * * *  (2am daily). Requires LEAN_ENABLED=true.
INCUBATION_CRON=
# Optional: auto-refresh market data on a schedule (spawns the pipeline).
# Fresh data is what lets ghost runs surface new forward observations.
# Example: 0 1 * * 1  (1am every Monday).
DATA_REFRESH_CRON=
# Optional webhook: quit-rule breaches / ghost-run errors POSTed here as JSON.
ALERT_WEBHOOK_URL=

# Postgres backups (Phase 15)
# ===========================
# Optional in-process nightly pg_dump of the local praxis-postgres container.
# The trial ledger and gate history are the crown jewels — back them up.
# Example: 0 3 * * *  (3am daily). Manual: npm run db:backup or
# POST /api/system/backup. Only works for a localhost DATABASE_URL.
BACKUP_CRON=
# How many dumps to keep in backups/ (oldest pruned). Default 30.
BACKUP_KEEP=30
# Override the dump directory (default: ./backups) or container name
# (default: praxis-postgres) if your setup differs.
#BACKUP_DIR=backups
#PG_CONTAINER=praxis-postgres
